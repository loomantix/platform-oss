{
  "name": "@loomantix/web-crypto",
  "version": "0.3.1",
  "type": "module",
  "description": "At-rest AES-256-GCM encryption helpers for browsers (WebCrypto + non-extractable CryptoKey persisted in IndexedDB, factory API).",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomantix/platform-oss.git",
    "directory": "packages/web-crypto"
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "fake-indexeddb": "catalog:",
    "happy-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
